# Supports the Nectar compiler for AMD64.

import toolset ;

if [ MATCH (--debug-configuration) : [ modules.peek : ARGV ] ]
{
    .debug-configuration = true ;
}

feature.extend toolset : nectar-amd64 ;

action compile-nectar-sources-amd64
{
  $(.NECTAR_CC) $(.NECTAR_AMD64_FLAGS) $(.NECTAR_AMD64_SOURCES)
}

