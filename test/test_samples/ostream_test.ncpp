struct iostream
{
    type <class Tp_>
    let consume(Tp_& val)
    {
        return;
    }

    let read()
    {
        let ch = getchar();
        return ch;
    }
};

let main()
{
    let six_seven = 100;
    let eight_nine = 1;

    let io = iostream();

    io.consume(eight_nine);
    io.consume(six_seven);

    return 0;
}
