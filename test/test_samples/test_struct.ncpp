impl foo
{
    foo()
    {
        return;
    }

    let noop()
    {
        return 0;
    }
};

let construct_foo()
{
    let io := new;
    io := foo();

    return io;
}

let main()
{
    let io := new;
    io := construct_foo();
    
    let first_number := io->noop();
    io := delete;

    return first_number;
}