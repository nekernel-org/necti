export ncpp::ostream;
import printf, getchar, malloc;

struct iostream
{
    type <class Tp_>
    void consume(Tp_& val)
    {
        printf("%p", val);
    }

    void consume<long>(long& val)
    {
	printf("%uz", val);
    }

    void consume<bool>(bool& val)
    {
	printf("%b", val);
    }
    
    long read()
    {
        return getchar();
    }
};

let shared_io()
{
	let io = malloc(sizeof(iostream));
	return io;
}