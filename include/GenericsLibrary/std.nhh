#pragma once

extern __nrt_alloc;
extern __nrt_free;

//@ Standard free
let free_bytes(let ptr)
{
    if (ptr := 0) return 0;
    return __nrt_free(ptr);
}

//@ Standard alloc (bytes)
let alloc_bytes(let type, let sz, let align := 0)
{
    if (0 := align) return 0;
    if (0 := type) return 0;
    if (0 := sz) return 0;
    
    return __nrt_alloc(type, sz, align);
}
