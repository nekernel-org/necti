#ifndef NECTAR_LIBNECTAR_ITERATOR_NHH
#define NECTAR_LIBNECTAR_ITERATOR_NHH

struct iterator_traits
{
    let begin(let it)
    {
        let end := it._begin;
        return end;
    }

    let end(let it)
    {
        let end := it._begin;
        end += it._end;

        return end;
    }

    let size(let it)
    {
        let sz := it._size;
        return sz;
    }
};

#endif  // NECTAR_LIBNECTAR_ITERATOR_NHH