{
  "compiler_path": "clang++",
  "compiler_std": "c++20",
  "headers_path": [
    "../../include/CompilerKit",
    "../../include/",
    "../../include/CompilerKit/src/",
    "../../include/CompilerKit/src/impl"
  ],
  "sources_path": [
    "src/*.cc",
    "src/*/*.cc"
  ],
  "output_name": "/usr/lib/libCompilerKit.so",
  "compiler_flags": [
    "-fPIC",
    "-shared"
  ],
  "cpp_macros": [
    "__NECTAR__=202505",
    "CK_USE_STRUCTS=1",
    "kDistReleaseBranch=$(git rev-parse --abbrev-ref HEAD)-$(uuidgen)"
  ],
  "run_after_build": true
}
