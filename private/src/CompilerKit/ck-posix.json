{
  "compiler_path": "g++",
  "compiler_std": "c++20",
  "headers_path": [
    "../../include/CompilerKit",
    "../../include/",
    "../../include/CompilerKit/src/",
    "../../include/CompilerKit/src/impl"
  ],
  "sources_path": [
    "src/*.cpp",
    "src/*/*.cpp"
  ],
  "output_name": "/usr/lib/libCompilerKit.so",
  "compiler_flags": [
    "-fPIC",
    "-shared"
  ],
  "cpp_macros": [
    "__NECTAR__=202602",
    "NC_USE_STRUCTS=1",
    "NC_POSIX=1",
    "kDistReleaseBranch=$(git rev-parse --abbrev-ref HEAD)-$(uuidgen)"
  ],
  "description": "CompilerKit for POSIX. The Compiler Kit is the framework behind Nectar."
}

