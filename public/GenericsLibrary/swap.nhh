#ifndef NECTAR_GL_SWAP_NHH
#define NECTAR_GL_SWAP_NHH

//@ Free swap functions for GenericsLibrary.

let swap(let a, let b)
{
    let temp := a;
    a := b;
    b := temp;
    return temp;
}

#endif //@ NECTAR_GL_SWAP_NHH
