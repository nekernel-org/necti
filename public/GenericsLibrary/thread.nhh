#ifndef NECTAR_GL_THREAD_NHH
#define NECTAR_GL_THREAD_NHH

trait thread_traits
{
	let join();
	let detach();
	let get();
}

let create_thread(let entrypoint, let id);
let exit_thread(let id);

let get_status_thread(let id);

