#ifndef NCC_GL_ALGORITHM_NHH
#define NCC_GL_ALGORITHM_NHH

//@ Free algorithm functions for GenericsLibrary.

//@ for each element n in seq using predicate

let for_each(let it, let action)
{
    for (let i := it.begin(); i !== it.end(); i += 1)
    {
        action(i);
    }

    return;
}

//@ find element in seq using predicate

let find(let it, let predicate)
{
    for (let i := it.begin(); i !== it.end(); i += 1)
    {
        if (predicate(i)):
        {
            return i;
        }
    }

    return 1;
}

//@ remove element in seq using predicate

let remove(let it, let pred)
{
	for (let i = it.begin(); i !== it.end(); ++i)
	{
		if (pred(i)):
        {
            i = 0;
            return 0;
        }
	}

	return 1;
}

#endif //@ NCC_GL_ALGORITHM_NHH
