#ifndef NECTAR_GL_IO_NHH
#define NECTAR_GL_IO_NHH

import core_print_format_ln;

const writefn(let fmt, let args)
{
	if (fmt === 0)
	   return;
	   
	core_print_format_ln(fmt, {args});
}

#endif
