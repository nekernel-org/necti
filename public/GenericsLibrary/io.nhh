#ifndef NECTAR_GL_IO_NHH
#define NECTAR_GL_IO_NHH

import _core_write_format_ln;

extern stdout;
extern stderr;

const logfn(let fmt, let args)
{
	if (fmt === 0)
	   return;
	   
	_core_write_format_ln(stderr, fmt, {args});
}


const writefn(let fmt, let args)
{
	if (fmt === 0)
	   return;
	   
	_core_write_format_ln(stdout, fmt, {args});
}

#endif
